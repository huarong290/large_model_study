<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lost.found.mapper.FoundItemMapper">

    <!-- ========================================== -->
    <!-- 结果映射：实体类字段 ↔ 数据库表字段          -->
    <!-- ========================================== -->
    <resultMap id="BaseResultMap" type="com.lost.found.entity.FoundItem">
        <id property="id" column="id"/>
        <result property="finderName" column="finder_name"/>
        <result property="finderPhone" column="finder_phone"/>
        <result property="findName" column="find_name"/>
        <result property="findDateTime" column="find_date_time"/>
        <result property="findLocation" column="find_location"/>
        <result property="findDescription" column="find_description"/>
        <result property="status" column="status"/>
        <result property="deleteFlag" column="delete_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <!-- ========================================== -->
    <!-- 通用查询列                                   -->
    <!-- ========================================== -->
    <sql id="Base_Column_List">
        id, finder_name, finder_phone, find_name, find_date_time,
        find_location, find_description, status, delete_flag,
        create_by, create_time, update_by, update_time
    </sql>

    <!-- ========================================== -->
    <!-- 基础 CRUD                                     -->
    <!-- ========================================== -->

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE id = #{id} AND delete_flag = 0
    </select>

    <!-- 查询所有（按创建时间倒序） -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE delete_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 根据状态查询 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE status = #{status} AND delete_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 模糊查询：按失物名称 -->
    <select id="selectByFindName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE find_name LIKE CONCAT('%', #{findName}, '%') AND delete_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 模糊查询：按拾得人姓名 -->
    <select id="selectByFinderName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE finder_name LIKE CONCAT('%', #{finderName}, '%') AND delete_flag = 0
        ORDER BY create_time DESC
    </select>

    <!-- 分页查询（按创建时间倒序） -->
    <select id="selectPageOrderByTime" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE delete_flag = 0
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>
    <select id="selectUnmatchedItems" resultType="com.lost.found.entity.FoundItem">
        SELECT
        <include refid="Base_Column_List"/>
        FROM found_item
        WHERE delete_flag = 0 and status =0
        ORDER BY create_time DESC
    </select>

    <!-- ========================================== -->
    <!-- 更新操作                                     -->
    <!-- ========================================== -->

    <!-- 更新状态 -->
    <update id="updateStatus">
        UPDATE found_item
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id} AND delete_flag = 0
    </update>

</mapper>