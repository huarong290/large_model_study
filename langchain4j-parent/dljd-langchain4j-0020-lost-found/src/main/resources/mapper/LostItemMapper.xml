<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lost.found.mapper.LostItemMapper">

    <!-- ========================================== -->
    <!-- 结果映射：实体类字段 ↔ 数据库表字段          -->
    <!-- ========================================== -->
    <resultMap id="BaseResultMap" type="com.lost.found.entity.LostItem">
        <id property="id" column="id"/>
        <result property="userName" column="user_name"/>
        <result property="phone" column="phone"/>
        <result property="lostName" column="lost_name"/>
        <result property="lostDateTime" column="lost_date_time"/>
        <result property="lostLocation" column="lost_location"/>
        <result property="lostDescription" column="lost_description"/>
        <result property="status" column="status"/>
        <result property="deleteFlag" column="delete_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>


    <!-- ========================================== -->
    <!-- 通用查询列（推荐使用 resultMap 代替）       -->
    <!-- ========================================== -->
    <sql id="Base_Column_List">
        id,
        user_name,
        phone,
        lost_name,
        lost_date_time,
        lost_location,
        lost_description,
        status,
        delete_flag,
        create_by,
        create_time,
        update_by,
        update_time
    </sql>

    <!-- ========================================== -->
    <!-- 基础 CRUD（使用 resultMap 避免字段遗漏）    -->
    <!-- ========================================== -->
    <!-- 根据手机号查询 -->
    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lost_item
        WHERE phone = #{phone} AND delete_flag = 0 and status =0
        ORDER BY id DESC
        LIMIT 100
    </select>


    <!-- ========================================== -->
    <!-- 更新操作                                     -->
    <!-- ========================================== -->

    <!-- 更新状态 -->
    <update id="updateStatus">
        UPDATE lost_item
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id} AND delete_flag = 0
    </update>
    <!-- ========================================== -->
    <!-- 动态更新：根据传入字段更新                   -->
    <!-- ========================================== -->
    <update id="updateLostItem">
        UPDATE lost_item
        <set>
            <if test="userName != null and userName != ''">
                user_name = #{userName},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="lostName != null and lostName != ''">
                lost_name = #{lostName},
            </if>
            <if test="lostDateTime != null and lostDateTime != ''">
                lost_date_time = #{lostDateTime},
            </if>
            <if test="lostLocation != null and lostLocation != ''">
                lost_location = #{lostLocation},
            </if>
            <if test="lostDescription != null and lostDescription != ''">
                lost_description = #{lostDescription},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="deleteFlag != null">
                delete_flag = #{deleteFlag},
            </if>
            <if test="createBy != null and createBy != ''">
                create_by = #{createBy},
            </if>
            <if test="updateBy != null and updateBy != ''">
                update_by = #{updateBy},
            </if>
            <!-- update_time 由数据库自动维护，不使用动态更新 -->
        </set>
        WHERE id = #{id}
    </update>

    <!-- ========================================== -->
    <!-- 动态更新（非空字段，只更新传入的非空值）     -->
    <!-- 推荐使用，避免将已有值覆盖为 null           -->
    <!-- ========================================== -->
    <update id="updateLostItemSelective">
        UPDATE lost_item
        <set>
            <if test="userName != null and userName != ''">
                user_name = #{userName},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="lostName != null and lostName != ''">
                lost_name = #{lostName},
            </if>
            <if test="lostDateTime != null and lostDateTime != ''">
                lost_date_time = #{lostDateTime},
            </if>
            <if test="lostLocation != null and lostLocation != ''">
                lost_location = #{lostLocation},
            </if>
            <if test="lostDescription != null and lostDescription != ''">
                lost_description = #{lostDescription},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="deleteFlag != null">
                delete_flag = #{deleteFlag},
            </if>
            <if test="createBy != null and createBy != ''">
                create_by = #{createBy},
            </if>
            <if test="updateBy != null and updateBy != ''">
                update_by = #{updateBy},
            </if>
        </set>
        WHERE id = #{id} AND delete_flag = 0
    </update>

    <!-- ========================================== -->
    <!-- 根据ID更新状态                              -->
    <!-- ========================================== -->
    <update id="updateLostItemStatus">
        UPDATE lost_item
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id} AND delete_flag = 0
    </update>

    <!-- ========================================== -->
    <!-- 根据ID更新逻辑删除状态（软删除）             -->
    <!-- ========================================== -->
    <update id="deleteLostItemById">
        UPDATE lost_item
        SET delete_flag = 1, update_time = NOW()
        WHERE id = #{id}
    </update>


</mapper>