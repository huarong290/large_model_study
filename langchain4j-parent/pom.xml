<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ai.study</groupId>
    <artifactId>langchain4j-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <module>spring-langchain4j-0001</module>
        <module>dljd-langchain4j-0001-quick</module>
        <module>dljd-langchain4j-0002-ai-service</module>
        <module>dljd-langchain4j-0003-ai-service</module>
        <module>dljd-langchain4j-0004-stream-out</module>
        <module>dljd-langchain4j-0005-prompt</module>
        <module>dljd-langchain4j-0006-description</module>
        <module>dljd-langchain4j-0007-chat-memory</module>
        <module>dljd-langchain4j-0008-chat-memory-store-mysql</module>
        <module>dljd-langchain4j-0009-chat-memory-store-redis</module>
        <module>dljd-langchain4j-0010-tools</module>
        <module>dljd-langchain4j-0020-lost-found</module>
    </modules>
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 统一版本管理 -->
        <spring-ai-alibaba.version>1.1.2.2</spring-ai-alibaba.version>
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-extensions.version>1.1.2.2</spring-ai-extensions.version>
        <spring-boot.version>3.5.8</spring-boot.version>
        <!-- 主 BOM 版本 -->
        <langchain4j.version>1.17.0</langchain4j.version>
        <!--openai版本 -->
        <langchain4j-openai.version>1.17.0-beta27</langchain4j-openai.version>
        <!-- 社区 BOM 版本，参考实际存在的版本，例如 1.17.0-beta27 或更新的版本 -->
        <langchain4j-community.version>1.17.0-beta27</langchain4j-community.version>
        <langchain4j-reactor.version>1.17.0-beta27</langchain4j-reactor.version>

        <!-- MyBatis-Plus 版本（新增） -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <!-- Hutool 版本（新增） -->
        <hutool.version>5.8.47</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 1. Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2. Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. Spring AI Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 4. Spring AI Alibaba Extensions BOM -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-extensions.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 5. LangChain4j 核心 BOM -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 6. LangChain4j 社区版 BOM (包含通义千问、DashScope 等) -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-community-bom</artifactId>
                <version>${langchain4j-community.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 7.LangChain4j Reactor 显式版本管理 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-reactor</artifactId>
                <version>${langchain4j-reactor.version}</version>
            </dependency>
            <!-- 8.MyBatis-Plus 版本管理（新增） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 9.Hutool 版本管理（新增） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>


    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>