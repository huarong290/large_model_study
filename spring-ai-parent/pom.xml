<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ai.study</groupId>
    <artifactId>spring-ai-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <modules>
        <!-- ========================================== -->
        <!-- 第一阶段：Spring AI 入门（msjt 前缀）         -->
        <!-- ========================================== -->
        <module>msjt-spring-ai-0001-quick-start</module>           <!-- Spring AI 快速入门：了解Spring AI基本概念、项目搭建、第一个AI调用 -->
        <module>msjt-spring-ai-0002-embedding-ollama</module>      <!-- Ollama Embedding：文本向量化、相似度计算、向量数据库基础 -->
        <module>msjt-spring-ai-0003-ollama-local-rag</module>      <!-- Ollama 本地RAG：文档加载、分块、向量检索、本地知识库问答 -->


        <!-- ========================================== -->
        <!-- 第二阶段：ChatClient 核心基础（mic 前缀）      -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0001</module>                        <!-- 基础配置：多模型配置、ChatClient Bean管理、配置文件最佳实践 -->
        <module>mic-spring-ai-0002-chat-client</module>            <!-- ChatClient基础：prompt/call/content调用链、System/User消息、同步调用 -->
        <module>mic-spring-ai-0003-chat-client-models</module>     <!-- 多模型对比：OpenAI/DashScope/Ollama切换、模型路由策略、性能与成本对比 -->
        <module>mic-spring-ai-0004-chat-client-options</module>    <!-- 参数配置：Temperature/MaxTokens/TopP调优、模型参数最佳实践 -->
        <module>mic-spring-ai-0005-chat-client-stream</module>     <!-- 流式响应：Flux响应式编程、SSE实时推送、聊天应用场景 -->

        <!-- ========================================== -->
        <!-- 第三阶段：提示词工程（mic 前缀）              -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0006-chat-client-template</module>   <!-- PromptTemplate：位置占位符{0}、命名占位符{name}、动态Prompt构建 -->
        <module>mic-spring-ai-0007-chat-client-structured</module> <!-- 结构化输出：映射到Java Bean/Record/List、自动生成JSON Schema -->

        <!-- ========================================== -->
        <!-- 第四阶段：高级特性（mic 前缀）               -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0008-chat-client-memory</module>     <!-- 对话记忆：InMemoryChatMemory、多轮对话上下文保持、会话隔离管理 -->
        <module>mic-spring-ai-0009-chat-client-rag</module>        <!-- RAG增强：向量数据库集成、文档检索增强、私有数据问答系统 -->
        <module>mic-spring-ai-0010-chat-client-tools</module>      <!-- 工具调用：@Tool注解定义、Function Calling、多工具协同工作 -->

        <!-- ========================================== -->
        <!-- 第五阶段：运维与扩展（mic 前缀）             -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0011-chat-client-advisor</module>    <!-- 自定义Advisor：拦截器机制、请求响应拦截、日志监控切面 -->
        <module>mic-spring-ai-0012-chat-client-observability</module> <!-- 可观测性：Micrometer指标收集、Token用量统计、响应时间监控 -->

        <!-- ========================================== -->
        <!-- 第六阶段：进阶特性（mic 前缀）               -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0013-chat-client-multi-model</module> <!-- 多模型路由：智能路由策略、模型降级、负载均衡 -->
        <module>mic-spring-ai-0014-chat-client-cache</module>      <!-- 缓存策略：Redis缓存集成、缓存Key设计、失效策略、成本优化 -->
        <module>mic-spring-ai-0015-chat-client-security</module>   <!-- 安全控制：敏感词过滤、权限控制、内容审核 -->
        <module>mic-spring-ai-0016-chat-client-evaluation</module> <!-- 效果评估：回答质量评分、A/B测试、人工评估接口 -->

        <!-- ========================================== -->
        <!-- 第七阶段：多模态与媒体处理（mic 前缀）        -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0017-chat-client-practice</module>   <!-- 综合实战：智能客服系统/知识库问答/代码助手 -->
        <module>mic-spring-ai-0018-audio-transcription</module>    <!-- 语音转文字：Whisper集成、实时音频转录 -->
        <module>mic-spring-ai-0019-text-to-speech</module>         <!-- 文字转语音：TTS语音合成、多音色支持 -->
        <module>mic-spring-ai-0020-image-generation</module>       <!-- 图像生成：DALL-E集成、文生图、风格控制 -->
        <module>mic-spring-ai-0021-image-recognition</module>      <!-- 图像识别：多模态模型、图生文、视觉问答 -->

        <!-- ========================================== -->
        <!-- 第八阶段：向量数据库与存储（mic 前缀）        -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0022-vector-store-pgvector</module>  <!-- PGVector：PostgreSQL向量数据库集成 -->
        <module>mic-spring-ai-0023-vector-store-redis</module>     <!-- Redis Vector：Redis向量存储与检索 -->
        <module>mic-spring-ai-0024-vector-store-milvus</module>    <!-- Milvus：专用向量数据库、大规模向量检索 -->

        <!-- ========================================== -->
        <!-- 第九阶段：批量处理与并发控制（mic 前缀）      -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0025-batch-processing</module>       <!-- 批量处理：批量请求、并发调用、性能优化 -->
        <module>mic-spring-ai-0026-rate-limiting</module>          <!-- 限流控制：令牌桶算法、漏桶算法、API配额管理 -->

        <!-- ========================================== -->
        <!-- 第十阶段：Agent与推理增强（mic 前缀）        -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0027-agent-basic</module>            <!-- Agent基础：规划能力、工具调用、自主决策 -->
        <module>mic-spring-ai-0028-agent-multi</module>            <!-- 多Agent：Agent协作、任务分工、通信机制 -->
        <module>mic-spring-ai-0029-agent-reasoning</module>        <!-- 推理增强：CoT思维链、ReAct模式、推理优化 -->

        <!-- ========================================== -->
        <!-- 第十一阶段：模型微调与优化（mic 前缀）           -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0030-fine-tuning</module>            <!-- 模型微调：自定义数据集训练、模型定制 -->
        <module>mic-spring-ai-0031-prompt-optimization</module>    <!-- Prompt优化：自动优化提示词、Few-shot学习 -->

        <!-- ========================================== -->
        <!-- 第十二阶段：国际化与多语言（mic 前缀）           -->
        <!-- ========================================== -->
        <module>mic-spring-ai-0032-i18n-support</module>           <!-- 国际化支持：多语言配置、本地化处理 -->
        <module>mic-spring-ai-0033-translation</module>            <!-- 翻译服务：实时翻译、多语言互译 -->
        <!-- 综合实战：智能客服/知识库问答/代码助手  -->
    </modules>
    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 统一版本管理 -->
        <spring-ai-alibaba.version>1.1.2.2</spring-ai-alibaba.version>
        <spring-ai.version>1.1.2</spring-ai.version>
        <spring-ai-extensions.version>1.1.2.2</spring-ai-extensions.version>
        <spring-boot.version>3.5.8</spring-boot.version>
        <!-- 主 BOM 版本 -->
        <langchain4j.version>1.17.0</langchain4j.version>
        <!--openai版本 -->
        <langchain4j-openai.version>1.17.0-beta27</langchain4j-openai.version>
        <!-- 社区 BOM 版本，参考实际存在的版本，例如 1.17.0-beta27 或更新的版本 -->
        <langchain4j-community.version>1.17.0-beta27</langchain4j-community.version>
        <langchain4j-reactor.version>1.17.0-beta27</langchain4j-reactor.version>

        <!-- MyBatis-Plus 版本（新增） -->
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <!-- Hutool 版本（新增） -->
        <hutool.version>5.8.47</hutool.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 1. Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2. Spring AI BOM -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 3. Spring AI Alibaba BOM -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 4. Spring AI Alibaba Extensions BOM -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-extensions-bom</artifactId>
                <version>${spring-ai-extensions.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 5. LangChain4j 核心 BOM -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 6. LangChain4j 社区版 BOM (包含通义千问、DashScope 等) -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-community-bom</artifactId>
                <version>${langchain4j-community.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 7.LangChain4j Reactor 显式版本管理 -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-reactor</artifactId>
                <version>${langchain4j-reactor.version}</version>
            </dependency>
            <!-- 8.MyBatis-Plus 版本管理（新增） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- 9.Hutool 版本管理（新增） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
        </dependencies>


    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>